# Hardening Photo Proofing App

# 1. Wyłącz listowanie katalogów
Options -Indexes

# 2. Chroń pliki bazy danych, logi, skrypty powłoki i pliki .enc
<FilesMatch "\.(sqlite|log|enc|sh|example|sql|md)$">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Blokada bezpośredniego dostępu do folderów z danymi, logami i skryptami
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data(/.*)?$ - [F,L]
    RewriteRule ^selection_logs(/.*)?$ - [F,L]
    RewriteRule ^scripts(/.*)?$ - [F,L]

    # Przekierowanie legacy /upload.php do admin/upload.php
    RewriteRule ^upload\.php$ admin/upload.php [R=301,L]
</IfModule>

# 3. Zablokuj dostęp do plików wrażliwych
<Files "config.php">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
</Files>

# 4. Nagłówki bezpieczeństwa
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
