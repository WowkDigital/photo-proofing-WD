<?php
/**
 * Configuration Template for photo-proofing-WD
 *
 * NOTE: It is strongly recommended to run the web installer (install.php)
 * which automatically creates the database and generates this file.
 *
 * In this version of photo-proofing-WD, gallery settings and credentials
 * are stored dynamically in the SQLite database (`settings` table)
 * and can be edited anytime from the Admin Panel (`/admin/settings.php`).
 */

require_once __DIR__ . '/db.php';

// Load settings from database into global constants
try {
    $stmt = $pdo->query("SELECT key, value FROM settings");
    while ($row = $stmt->fetch()) {
        $val = $row['value'];
        // Convert boolean flags
        if (in_array($row['key'], ['TELEGRAM_BOT_ENABLED', 'PASSWORD_PROTECTION_ENABLED'])) {
            $val = ($val === '1' || $val === 'true');
        }
        if (!defined($row['key'])) {
            define($row['key'], $val);
        }
    }
} catch (Exception $e) {
    // Fallback if settings table is inaccessible
}

// ------------------------------------------------------------------
// FALLBACK DEFAULTS (if database is uninitialized or missing keys)
// ------------------------------------------------------------------
if (!defined('ALBUM_TITLE')) define('ALBUM_TITLE', 'Client Selection Gallery');
if (!defined('PASSWORD_PROTECTION_ENABLED')) define('PASSWORD_PROTECTION_ENABLED', false);
if (!defined('GALLERY_PASSWORD')) define('GALLERY_PASSWORD', 'change-me');
if (!defined('TELEGRAM_BOT_ENABLED')) define('TELEGRAM_BOT_ENABLED', false);
